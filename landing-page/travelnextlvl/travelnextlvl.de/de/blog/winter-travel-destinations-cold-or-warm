<script>
  document.addEventListener("DOMContentLoaded", () => {
    const languageLinks = document.querySelectorAll('[data-lang]');
    
    languageLinks.forEach(link => {
        link.addEventListener("click", (event) => {
            event.preventDefault();
            
            
            const selectedLanguage = link.getAttribute('data-lang');
            
            
            const currentUrl = new URL(window.location.href);
            
            
            const pathSegments = currentUrl.pathname.split('/').filter(Boolean);
            pathSegments[0] = selectedLanguage;
            
            
            currentUrl.pathname = `/${pathSegments.join('/')}`;
            
            
            localStorage.setItem('selectedLanguage', selectedLanguage);
            
            
            window.location.href = currentUrl.toString();
        });
    });

    
    const savedLanguage = localStorage.getItem('selectedLanguage');
    if (savedLanguage) {
        languageLinks.forEach(link => {
            const language = link.getAttribute('data-lang');
            if (language === savedLanguage) {
                link.classList.add('active');
            } else {
                link.classList.remove('active');
            }
        });
    }
  });
</script>

<script>
function deeplySearchShadowRoots(root) {
  let found = false;

  function walk(node) {
    if (!node) return;

    if (node.shadowRoot) {
      node = node.shadowRoot;
    }

    if (node.querySelectorAll) {
      // Перекрашиваем текст "Powered by"
      node.querySelectorAll('*').forEach(el => {
        if (el.textContent && /powered by/i.test(el.textContent)) {
          el.style.color = '#000';
          found = true;
        }
      });

      // Перекрашиваем все SVG path
      const paths = node.querySelectorAll('svg path');
      if (paths.length > 0) {
        paths.forEach(p => p.setAttribute('fill', '#000'));
        found = true;
      }
    }

    if (node.childNodes && node.childNodes.length > 0) {
      node.childNodes.forEach(child => walk(child));
    }
  }

  walk(root);
  return found;
}

let tries = 0;
const interval = setInterval(() => {
  const widgets = document.querySelectorAll('tpwl-tickets');
  let updated = false;

  widgets.forEach(widget => {
    if (widget.shadowRoot) {
      const result = deeplySearchShadowRoots(widget.shadowRoot);
      if (result) updated = true;
    }
  });

  if (updated || tries++ > 50) {
    clearInterval(interval);
  }
}, 300);
</script><script>
document.addEventListener('DOMContentLoaded', function() {
    const voiceButton = document.querySelector('.voice_box');
    const textElement = document.querySelector('.content_article');
    const progressBar = document.querySelector('.active_bar');
    let utterance = null;
    let isPlaying = false;

    if (voiceButton && textElement && progressBar) {
        voiceButton.addEventListener('click', () => {
           
            if (isPlaying) {
                window.speechSynthesis.cancel();
                progressBar.style.width = '0%';
                isPlaying = false;
                return;
            }

            
            const text = textElement.innerText;
            utterance = new SpeechSynthesisUtterance(text);

            utterance.lang = 'en-US';
            utterance.rate = 1;
            utterance.pitch = 1;

            progressBar.style.width = '0%';
            window.speechSynthesis.cancel();

            let startTime = null;
            isPlaying = true;

            
            const updateProgress = () => {
                if (startTime !== null) {
                    const elapsedTime = performance.now() - startTime;
                    const totalDuration = text.length * 70;
                    const progress = Math.min(100, (elapsedTime / totalDuration) * 100);

                    progressBar.style.width = `${progress}%`;

                    if (isPlaying && progress < 100) {
                        requestAnimationFrame(updateProgress);
                    }
                }
            };

            
            utterance.onstart = () => {
                startTime = performance.now();
                updateProgress();
            };

            
            utterance.onend = () => {
                progressBar.style.width = '100%';
                isPlaying = false;
            };

            window.speechSynthesis.speak(utterance);
        });
    }
});
</script>

