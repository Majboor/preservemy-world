document.addEventListener('DOMContentLoaded', function() {
    const voiceButton = document.querySelector('.voice_box');
    const textElement = document.querySelector('.content_article');
    const progressBar = document.querySelector('.active_bar');
    let utterance = null;
    let isPlaying = false;

    if (voiceButton && textElement && progressBar) {
        voiceButton.addEventListener('click', () => {
           
            if (isPlaying) {
                window.speechSynthesis.cancel();
                progressBar.style.width = '0%';
                isPlaying = false;
                return;
            }

            
            const text = textElement.innerText;
            utterance = new SpeechSynthesisUtterance(text);

            utterance.lang = 'en-US';
            utterance.rate = 1;
            utterance.pitch = 1;

            progressBar.style.width = '0%';
            window.speechSynthesis.cancel();

            let startTime = null;
            isPlaying = true;

            
            const updateProgress = () => {
                if (startTime !== null) {
                    const elapsedTime = performance.now() - startTime;
                    const totalDuration = text.length * 70;
                    const progress = Math.min(100, (elapsedTime / totalDuration) * 100);

                    progressBar.style.width = `${progress}%`;

                    if (isPlaying && progress < 100) {
                        requestAnimationFrame(updateProgress);
                    }
                }
            };

            
            utterance.onstart = () => {
                startTime = performance.now();
                updateProgress();
            };

            
            utterance.onend = () => {
                progressBar.style.width = '100%';
                isPlaying = false;
            };

            window.speechSynthesis.speak(utterance);
        });
    }
});
</script>

