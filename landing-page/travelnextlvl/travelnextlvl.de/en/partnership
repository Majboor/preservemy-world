<script>
  document.addEventListener("DOMContentLoaded", () => {
    const languageLinks = document.querySelectorAll('[data-lang]');
    
    languageLinks.forEach(link => {
        link.addEventListener("click", (event) => {
            event.preventDefault();
            
            
            const selectedLanguage = link.getAttribute('data-lang');
            
            
            const currentUrl = new URL(window.location.href);
            
            
            const pathSegments = currentUrl.pathname.split('/').filter(Boolean);
            pathSegments[0] = selectedLanguage;
            
            
            currentUrl.pathname = `/${pathSegments.join('/')}`;
            
            
            localStorage.setItem('selectedLanguage', selectedLanguage);
            
            
            window.location.href = currentUrl.toString();
        });
    });

    
    const savedLanguage = localStorage.getItem('selectedLanguage');
    if (savedLanguage) {
        languageLinks.forEach(link => {
            const language = link.getAttribute('data-lang');
            if (language === savedLanguage) {
                link.classList.add('active');
            } else {
                link.classList.remove('active');
            }
        });
    }
  });
</script>

<script>
function deeplySearchShadowRoots(root) {
  let found = false;

  function walk(node) {
    if (!node) return;

    if (node.shadowRoot) {
      node = node.shadowRoot;
    }

    if (node.querySelectorAll) {
      // Перекрашиваем текст "Powered by"
      node.querySelectorAll('*').forEach(el => {
        if (el.textContent && /powered by/i.test(el.textContent)) {
          el.style.color = '#000';
          found = true;
        }
      });

      // Перекрашиваем все SVG path
      const paths = node.querySelectorAll('svg path');
      if (paths.length > 0) {
        paths.forEach(p => p.setAttribute('fill', '#000'));
        found = true;
      }
    }

    if (node.childNodes && node.childNodes.length > 0) {
      node.childNodes.forEach(child => walk(child));
    }
  }

  walk(root);
  return found;
}

let tries = 0;
const interval = setInterval(() => {
  const widgets = document.querySelectorAll('tpwl-tickets');
  let updated = false;

  widgets.forEach(widget => {
    if (widget.shadowRoot) {
      const result = deeplySearchShadowRoots(widget.shadowRoot);
      if (result) updated = true;
    }
  });

  if (updated || tries++ > 50) {
    clearInterval(interval);
  }
}, 300);
</script><script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.8.0/gsap.min.js"></script>
