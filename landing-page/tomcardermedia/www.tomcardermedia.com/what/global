function initLoader() {
  const pageWrap   = document.querySelector('.page_wrap');
  const loaderWrap = document.querySelector('.page_loader');
  const overlay    = document.querySelector('.page_loader_overlay');
  const cover      = document.querySelector('.page_loader_cover');

  if (!pageWrap || !loaderWrap || !overlay || !cover) return;
  
  const isHomePageLoaderPresent = document.querySelector('.crisp-header');

  if (!isHomePageLoaderPresent) {
    gsap.set(loaderWrap, { display: "block" });
    gsap.set(overlay,    { opacity: 0 });
    gsap.set(cover,      { yPercent: 0, autoAlpha: 1, rotation: 0 });

    gsap.to(cover, {
      autoAlpha: 0,
      duration: 0.5,
      delay: 0.25,
      ease: "power1.out",
      onComplete: () => {
        gsap.set(loaderWrap, { display: "none" });
      }
    });
  } else {
    gsap.set(loaderWrap, { display: "none" });
  }

  const validLinks = Array.from(document.querySelectorAll("a")).filter(link => {
    const href = link.getAttribute("href") || "";
    const hostname = new URL(link.href, window.location.origin).hostname;

    return (
      hostname === window.location.hostname &&
      !href.startsWith("#") &&
      link.getAttribute("target") !== "_blank" &&
      !link.hasAttribute("data-transition-prevent")
    );
  });

  validLinks.forEach(link => {
    link.addEventListener("click", (event) => {
      if (link.href === window.location.href) return;
      
      event.preventDefault();
      const destination = link.href;

      gsap.set(loaderWrap, { display: "block" });
      gsap.set(overlay,    { opacity: 0 });
      gsap.set(cover,      { yPercent: 100, autoAlpha: 1, rotation: 25 });

      const outTl = gsap.timeline({
        defaults: { ease: "power4.out" },
        onComplete: () => {
          window.location.href = destination;
        }
      });

      outTl
        .to(overlay,  { opacity: 0.4, duration: 0.6 }, 0)
        .to(pageWrap, { y: -200,      duration: 0.6 }, 0)
