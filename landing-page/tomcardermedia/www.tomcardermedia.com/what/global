function initDetectPageTop() {
  const thresholdTop = 300;

  // Set initial state
  const initialScrollTop = window.scrollY;
  const initialAtTop = initialScrollTop <= thresholdTop;
  document.querySelectorAll('[data-page-top]').forEach(el =>
    el.setAttribute('data-page-top', initialAtTop ? 'true' : 'false')
  );

  // Listen for scroll changes
  window.addEventListener('scroll', () => {
    const nowScrollTop = window.scrollY;

    const atTop = nowScrollTop <= thresholdTop;
    document.querySelectorAll('[data-page-top]').forEach(el =>
      el.setAttribute('data-page-top', atTop ? 'true' : 'false')
    );
  });
}

// Initialize Detect Page Top
document.addEventListener('DOMContentLoaded', () => {
  initDetectPageTop();
});
